rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId && isImage();
    }

    match /departments/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /medical_records/{patientId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == patientId;
      allow write: if signedIn() && request.auth.uid == patientId && request.resource.size < 10 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
